[Unit]
Description=Route a specific IPv6 subnet to a given kind node
After=docker.service
{% if enable_ipv6_tunnel | bool %}
After=wg-ipv6-tunnel.service
Wants=wg-ipv6-tunnel.service
{% endif %}
PartOf=docker.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/node-ipv6-route {{ node_name }} {{ node_subnet }}
ExecStopPost=-/usr/sbin/ip -6 route del {{ node_subnet }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target docker.service
